# =============================================================================
# LET Junior — WhatsApp AI Sales Agent
# =============================================================================
# Copy this file to `.env.local` for local development, or paste these keys
# into Vercel → Project → Settings → Environment Variables for production.
#
# NOTHING here is required to START the project. With an empty config the
# service runs in DEMO MODE: in-memory database, fake AI replies, no messages
# ever sent to WhatsApp. Fill sections in as you get each account ready.
# The admin panel's Setup page shows you exactly what is still missing.
# =============================================================================


# --- 1. Admin panel ----------------------------------------------------------
# The only thing you truly need to set before deploying. This is the password
# you type to open the admin panel. Pick something long.
ADMIN_PASSWORD=

# Used to sign your login cookie. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# --- 2. Safety switches ------------------------------------------------------
# development = never sends a real WhatsApp message, logs instead (safe default)
# production  = sends real messages
ENVIRONMENT=development

# Master kill switch. false = the bot records everything but sends nothing.
# You can also flip this from the admin panel without redeploying.
# Setting it to false HERE overrides the panel and forces the bot off.
BOT_ENABLED=true


# --- 3. AI provider ----------------------------------------------------------
# Which AI service writes the replies. Options:
#   mock              -> no account needed, canned Spanish replies (default)
#   anthropic         -> Claude
#   openai-compatible -> OpenAI, Groq, Together, OpenRouter, Mistral, local, ...
AI_PROVIDER=mock

# --- 3a. If AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- 3b. If AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Applies to every provider
AI_MAX_TOKENS=600
# Stop talking to a lead and escalate once they have cost more than this (USD)
AI_COST_CEILING_USD=1.00


# --- 4. Database (Supabase) --------------------------------------------------
# Leave empty to use the in-memory demo database (data resets on every deploy).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# --- 5. WhatsApp / Meta ------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Check Meta's changelog for the current version before you set this.
META_GRAPH_VERSION=v23.0
# Conversions API dataset — only needed for M6, leave empty for now.
META_DATASET_ID=


# --- 6. Google Calendar (trial class booking) --------------------------------
# The service account JSON file, base64 encoded:
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
# Your timezone and working hours for trial classes (24h clock, local time).
BOOKING_TIMEZONE=America/Bogota
BOOKING_HOURS_START=14
BOOKING_HOURS_END=20


# --- 7. Stripe (payment links) -----------------------------------------------
STRIPE_SECRET_KEY=


# --- 8. Operations -----------------------------------------------------------
# Your personal WhatsApp number, international format, no + and no spaces.
# This is where escalation alerts land.
OWNER_WHATSAPP_NUMBER=

# Protects the scheduled jobs. Any long random string.
CRON_SECRET=
